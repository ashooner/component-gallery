---
interface Props { status: "verified" | "inferred" | "unknown" }
const { status } = Astro.props;
---
<span class:list={["status-badge", `status-badge--${status}`]}>{status}</span>

<style>
  .status-badge { display:inline-block; border:1px solid currentColor; border-radius:999px; padding:.15rem .45rem; font-size:.72rem; line-height:1; text-transform:uppercase; letter-spacing:.04em; }
  .status-badge--verified { color:#176b45; }
  .status-badge--inferred { color:#8a5b00; }
  .status-badge--unknown { color:#666; }
  :global(.dark) .status-badge--verified { color:#78d7a9; }
  :global(.dark) .status-badge--inferred { color:#f4c968; }
  :global(.dark) .status-badge--unknown { color:#bbb; }
</style>
