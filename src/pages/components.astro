---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import InventoryCard from "../components/InventoryCard.astro";
import Select from "../components/Select.astro";

const components = (await getCollection("components")).sort((a, b) => a.data.name.localeCompare(b.data.name));
const examples = await getCollection("componentExamples");
const counts = Object.fromEntries(components.map(({ id }) => [id, examples.filter((example) => example.data.canonicalComponent === id).length]));
---
<BaseLayout title="Canonical concepts" description="Canonical higher-education component concepts, kept separate from source implementation APIs.">
  <Hero>
    <span>Canonical component concepts</span>
    <Fragment slot="controls">
      <div class="flex flex-wrap items-center justify-between gap-3 bg-background-primary p-3">
        <p class="text-sm max-w-2xl">Concepts describe shared intent and anatomy. Source names, props, slots, states, and variants remain attached to implementations.</p>
        <Select label="Sort by:" id="sort-select">
          <option value="name">Name</option>
          <option value="example-count">Implementation count</option>
        </Select>
      </div>
    </Fragment>
  </Hero>
  <ul id="components" class="col-span-full grid grid-cols-subgrid gap-px" role="list">
    {components.map((component) => <InventoryCard
      href={`/components/${component.data.slug}`}
      eyebrow={`${component.data.emoji} Canonical concept`}
      title={component.data.name}
      description={component.data.purpose}
      tags={component.data.aliases}
      count={counts[component.id]}
      data-name={component.data.name}
      data-example-count={counts[component.id]}
    />)}
  </ul>
  <script>
    const select = document.querySelector<HTMLSelectElement>("#sort-select");
    const list = document.querySelector<HTMLUListElement>("#components");
    const sort = () => {
      if (!select || !list) return;
      const items = Array.from(list.children) as HTMLElement[];
      items.sort((a, b) => select.value === "example-count"
        ? Number(b.dataset.exampleCount) - Number(a.dataset.exampleCount)
        : (a.dataset.name ?? "").localeCompare(b.dataset.name ?? ""));
      items.forEach((item) => list.append(item));
      const url = new URL(location.href); url.searchParams.set("sort", select.value); history.replaceState({}, "", url);
    };
    if (select) { select.value = new URL(location.href).searchParams.get("sort") ?? "name"; select.addEventListener("change", sort); sort(); }
  </script>
</BaseLayout>
