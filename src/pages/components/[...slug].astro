---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilterCheckbox from "../../components/FilterCheckbox.astro";
import FilterDropdown from "../../components/FilterDropdown.astro";
import InventoryCard from "../../components/InventoryCard.astro";
import StatusBadge from "../../components/StatusBadge.astro";

export async function getStaticPaths() {
  return (await getCollection("components")).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const allExamples = await getCollection("componentExamples");
const examples = allExamples.filter(({ data }) => data.canonicalComponent === entry.id);
const systems = await getCollection("designSystems");
const resources = (await getCollection("resources")).filter(({ data }) => data.canonicalComponents.includes(entry.id));
const systemById = Object.fromEntries(systems.map((system) => [system.id, system]));
const implementationTypes = [...new Set(examples.map(({ data }) => data.implementationType))];
const systemNames = [...new Set(examples.map(({ data }) => systemById[data.designSystem]?.data.name).filter(Boolean))];
---
<BaseLayout title={`${entry.data.emoji} ${entry.data.name}`} description={entry.data.purpose}>
  <section class="col-span-full grid grid-cols-subgrid bg-background-primary shadow-border" data-pagefind-body>
    <div class="col-span-full lg:col-span-8 p-[var(--grid-display-size)]">
      <p class="text-xs uppercase tracking-wider">Canonical concept · descriptive inventory</p>
      <h1 class="font-serif text-[calc(var(--grid-display-size)*3)] leading-none mt-3">{entry.data.name}</h1>
      <p class="text-xl variable-font-wdth-90 mt-6 max-w-3xl">{entry.data.purpose}</p>
      <p class="text-sm mt-5"><strong>Aliases:</strong> <span data-other-names>{entry.data.aliases.join(", ")}</span></p>
    </div>
    <aside class="col-span-full lg:col-span-4 p-4 bg-background-secondary">
      <h2 class="uppercase tracking-wide text-sm">Anatomy</h2>
      <ol class="mt-3 space-y-2 list-decimal ml-5">{entry.data.anatomy.map((part) => <li>{part}</li>)}</ol>
      <h2 class="uppercase tracking-wide text-sm mt-6">Relationships</h2>
      <p class="text-sm mt-2"><strong>Contains:</strong> {entry.data.relationships.contains.join(", ")}</p>
      <p class="text-sm mt-2"><strong>Related:</strong> {entry.data.relationships.relatedTo.map((slug) => <a class="underline mr-2" href={`/components/${slug}`}>{slug}</a>)}</p>
    </aside>
  </section>

  <section class="col-span-full bg-background-primary shadow-border">
    <div class="p-4 flex flex-wrap gap-3 items-center justify-between">
      <div>
        <h2 class="text-2xl font-serif">Source implementations</h2>
        <p id="result-count" class="text-sm mt-1" aria-live="polite">{examples.length} documented implementations</p>
      </div>
      <div class="flex flex-wrap">
        <FilterDropdown heading="Institution" id="system-filter">
          {systemNames.map((name) => <FilterCheckbox filterType="system" filterValue={name}>{name}</FilterCheckbox>)}
        </FilterDropdown>
        <FilterDropdown heading="Technology" id="type-filter">
          {implementationTypes.map((type) => <FilterCheckbox filterType="type" filterValue={type}>{type}</FilterCheckbox>)}
        </FilterDropdown>
      </div>
    </div>
    <ul id="implementation-list" class="grid grid-cols-12 gap-px" role="list">
      {examples.map((example) => <InventoryCard
        href={`/implementations/${example.data.slug}`}
        eyebrow={`${systemById[example.data.designSystem]?.data.name} · ${example.data.implementationType}`}
        title={example.data.sourceName}
        description={example.data.summary}
        tags={example.data.namedPresets.slice(0, 3)}
        data-system={systemById[example.data.designSystem]?.data.name}
        data-type={example.data.implementationType}
      />)}
    </ul>
  </section>

  <section class="col-span-full bg-background-primary p-4 shadow-border overflow-x-auto" data-pagefind-body>
    <h2 class="font-serif text-2xl">Variant comparison</h2>
    <p class="text-sm mt-2 max-w-3xl">Dimensions and named presets are recorded separately. “Unknown” means the inspected source did not document the behavior; it does not mean unsupported.</p>
    <table class="inventory-table mt-4">
      <thead><tr><th>Source implementation</th><th>Dimension</th><th>Exact source name</th><th>Values</th><th>Evidence</th></tr></thead>
      <tbody>{examples.flatMap((example) => example.data.variantDimensions.length ? example.data.variantDimensions.map((dimension) => <tr>
        <th><a href={`/implementations/${example.data.slug}`}>{example.data.sourceName}</a></th>
        <td>{dimension.name}</td><td><code>{dimension.sourceName}</code></td><td>{dimension.values.join(" · ")}</td><td><StatusBadge status={dimension.status} /></td>
      </tr>) : [<tr><th><a href={`/implementations/${example.data.slug}`}>{example.data.sourceName}</a></th><td colspan="3">No variant dimension documented in the inspected source.</td><td><StatusBadge status="unknown" /></td></tr>])}</tbody>
    </table>
  </section>

  <section class="col-span-full bg-background-primary p-4 shadow-border overflow-x-auto" data-pagefind-body>
    <h2 class="font-serif text-2xl">Props, slots, attributes, methods, and events</h2>
    <table class="inventory-table mt-4">
      <thead><tr><th>Source</th><th>Kind</th><th>Exact name</th><th>Type / values</th><th>Required</th><th>Status</th></tr></thead>
      <tbody>{examples.flatMap((example) => example.data.api.map((item) => <tr>
        <th><a href={`/implementations/${example.data.slug}`}>{example.data.sourceName}</a></th><td>{item.kind}</td><td><code>{item.name}</code></td>
        <td>{[item.type, item.values?.join(" | ")].filter(Boolean).join(": ") || "—"}</td><td>{item.required === undefined ? "Not stated" : item.required ? "Yes" : "No"}</td><td><StatusBadge status={item.status} /></td>
      </tr>))}</tbody>
    </table>
  </section>

  <section class="col-span-full bg-background-primary p-4 shadow-border" data-pagefind-body>
    <h2 class="font-serif text-2xl">Evidence and supporting resources</h2>
    <ul class="mt-4 grid sm:grid-cols-2 gap-3">{resources.map((resource) => <li class="border border-border-primary p-3">
      <div class="flex justify-between gap-3"><a class="underline font-medium" href={resource.data.url}>{resource.data.name}</a><StatusBadge status={resource.data.status} /></div>
      <p class="text-sm mt-2">{resource.data.type} · {resource.data.version}</p>
      {resource.data.commit && <p class="font-mono text-xs break-all mt-1">{resource.data.commit}</p>}
    </li>)}</ul>
  </section>

  <script>
    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>(".filter-checkbox input"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("#implementation-list > li"));
    const count = document.querySelector<HTMLElement>("#result-count");
    const apply = () => {
      const active = { system: [] as string[], type: [] as string[] };
      inputs.filter((input) => input.checked).forEach((input) => active[input.dataset.filterType as "system" | "type"].push(input.dataset.filterValue ?? ""));
      let visible = 0;
      cards.forEach((card) => { const show = (!active.system.length || active.system.includes(card.dataset.system ?? "")) && (!active.type.length || active.type.includes(card.dataset.type ?? "")); card.hidden = !show; if (show) visible++; });
      if (count) count.textContent = `${visible} documented implementation${visible === 1 ? "" : "s"}`;
      const url = new URL(location.href); ["system", "type"].forEach((key) => { url.searchParams.delete(key); active[key as "system" | "type"].forEach((value) => url.searchParams.append(key, value)); }); history.replaceState({}, "", url);
    };
    const params = new URL(location.href).searchParams;
    inputs.forEach((input) => { input.checked = params.getAll(input.dataset.filterType ?? "").includes(input.dataset.filterValue ?? ""); input.addEventListener("change", apply); }); apply();
  </script>
</BaseLayout>

<style>
  .inventory-table { width:100%; min-width:55rem; border-collapse:collapse; font-size:.875rem; }
  .inventory-table th,.inventory-table td { border:1px solid theme("colors.border-primary"); padding:.65rem; text-align:left; vertical-align:top; }
  .inventory-table thead th { text-transform:uppercase; letter-spacing:.04em; font-size:.72rem; }
  .inventory-table tbody th { font-weight:600; }
  .inventory-table a { text-decoration:underline; text-underline-offset:2px; }
  code { font-size:.78rem; overflow-wrap:anywhere; }
</style>
