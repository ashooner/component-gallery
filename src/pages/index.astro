---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import InventoryCard from "../components/InventoryCard.astro";
import CTA from "../components/CTA.astro";

const components = await getCollection("components");
const systems = await getCollection("designSystems");
const examples = await getCollection("componentExamples");
const resources = await getCollection("resources");
const counts = Object.fromEntries(components.map(({ id }) => [id, examples.filter((example) => example.data.canonicalComponent === id).length]));
---
<BaseLayout title="" description="A version-controlled higher-education component inventory with source-level API evidence.">
  <Hero isHomepage>
    <span>{components.length}&nbsp;concepts,<br />{systems.length}&nbsp;university systems,<br />{examples.length}&nbsp;verified implementations.</span>
    <Fragment slot="controls"><div class="p-[var(--grid-display-size)] pt-0 bg-background-primary"><p class="max-w-3xl text-lg lg:text-xl text-pretty variable-font-wdth-90 text-center mx-auto"><em>The Higher-Ed Component Inventory</em> separates shared interface concepts from the exact APIs published by university design systems. It records evidence and uncertainty without turning missing documentation into “unsupported.”</p></div></Fragment>
  </Hero>
  <div class="col-span-full flex justify-between bg-background-primary p-4 shadow-border"><h2 class="uppercase tracking-wide">Canonical concepts</h2><CTA href="/components">Browse concepts</CTA></div>
  <ul class="col-span-full grid grid-cols-subgrid gap-px" role="list">{components.map((component) => <InventoryCard href={`/components/${component.data.slug}`} eyebrow="Canonical concept" title={component.data.name} description={component.data.purpose} tags={component.data.aliases} count={counts[component.id]} />)}</ul>
  <div class="col-span-full flex justify-between bg-background-primary p-4 shadow-border"><h2 class="uppercase tracking-wide">Initial research systems</h2><CTA href="/design-systems">Browse systems</CTA></div>
  <ul class="col-span-full grid grid-cols-subgrid gap-px" role="list">{systems.map((system) => <InventoryCard href={`/design-systems/${system.data.slug}`} eyebrow={system.data.university} title={system.data.name} description={`${system.data.library} · ${system.data.version}`} tags={system.data.technologies} count={examples.filter(({ data }) => data.designSystem === system.id).length} />)}</ul>
  <section class="col-span-full grid grid-cols-12 gap-px bg-background-primary">
    <div class="col-span-full lg:col-span-7 p-[var(--grid-display-size)] shadow-border"><h2 class="font-serif text-3xl">Evidence-first research</h2><p class="text-lg mt-4 max-w-2xl">Every implementation links to documentation or pinned source, records version or commit and retrieval date, and marks claims as verified, inferred, or unknown.</p><p class="mt-4"><a class="underline" href="/resources">Review {resources.length} research sources</a></p></div>
    <div class="col-span-full lg:col-span-5 p-[var(--grid-display-size)] shadow-border"><h2 class="font-serif text-3xl">Inventory, not specification</h2><p class="text-lg mt-4">This dataset is descriptive. A future UK higher-education component specification belongs in a separate selection profile and is not implied by frequency or presence here.</p></div>
  </section>
</BaseLayout>
