---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import InventoryCard from "../components/InventoryCard.astro";
import FilterDropdown from "../components/FilterDropdown.astro";
import FilterCheckbox from "../components/FilterCheckbox.astro";
import Select from "../components/Select.astro";

const systems = await getCollection("designSystems");
const examples = await getCollection("componentExamples");
const techs = [...new Set(systems.flatMap(({ data }) => data.technologies))].sort();
const groups = [...new Set(systems.flatMap(({ data }) => data.researchGroups))].sort();
---
<BaseLayout title="Higher-education design systems" description="Universities, component libraries, technologies, versions, documentation, and integration evidence.">
  <Hero>
    <span>Higher-education design systems</span>
    <Fragment slot="controls">
      <div class="flex flex-wrap items-center justify-between bg-background-primary p-2 gap-2">
        <div class="flex flex-wrap">
          <FilterDropdown heading="Technology" id="tech-filter">{techs.map((tech) => <FilterCheckbox filterType="tech" filterValue={tech}>{tech}</FilterCheckbox>)}</FilterDropdown>
          <FilterDropdown heading="Research group" id="group-filter">{groups.map((group) => <FilterCheckbox filterType="group" filterValue={group}>{group}</FilterCheckbox>)}</FilterDropdown>
        </div>
        <Select label="Sort by:" id="sort-select"><option value="name">Name</option><option value="count">Implementation count</option></Select>
      </div>
    </Fragment>
  </Hero>
  <p id="result-count" class="col-span-full bg-background-primary p-4 shadow-border" aria-live="polite">{systems.length} systems</p>
  <ul id="systems" class="col-span-full grid grid-cols-subgrid gap-px" role="list">
    {systems.map((system) => {
      const count = examples.filter(({ data }) => data.designSystem === system.id).length;
      return <InventoryCard
        href={`/design-systems/${system.data.slug}`}
        eyebrow={system.data.university}
        title={system.data.name}
        description={`${system.data.library} · ${system.data.version}`}
        tags={system.data.technologies}
        count={count}
        data-name={system.data.name}
        data-count={count}
        data-tech={system.data.technologies.join("|")}
        data-group={system.data.researchGroups.join("|")}
      />;
    })}
  </ul>
  <script>
    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>(".filter-checkbox input"));
    const list = document.querySelector<HTMLUListElement>("#systems");
    const select = document.querySelector<HTMLSelectElement>("#sort-select");
    const count = document.querySelector<HTMLElement>("#result-count");
    const update = () => {
      if (!list || !select) return;
      const active = { tech: [] as string[], group: [] as string[] };
      inputs.filter((input) => input.checked).forEach((input) => active[input.dataset.filterType as "tech" | "group"].push(input.dataset.filterValue ?? ""));
      const items = Array.from(list.children) as HTMLElement[]; let visible = 0;
      items.forEach((item) => { const show = active.tech.every((value) => (item.dataset.tech ?? "").split("|").includes(value)) && active.group.every((value) => (item.dataset.group ?? "").split("|").includes(value)); item.hidden = !show; if (show) visible++; });
      items.sort((a,b) => select.value === "count" ? Number(b.dataset.count)-Number(a.dataset.count) : (a.dataset.name ?? "").localeCompare(b.dataset.name ?? "")).forEach((item) => list.append(item));
      if (count) count.textContent = `${visible} system${visible === 1 ? "" : "s"}`;
      const url = new URL(location.href); ["tech","group"].forEach((key) => { url.searchParams.delete(key); active[key as "tech"|"group"].forEach((value) => url.searchParams.append(key,value)); }); url.searchParams.set("sort", select.value); history.replaceState({},"",url);
    };
    const params = new URL(location.href).searchParams;
    inputs.forEach((input) => { input.checked = params.getAll(input.dataset.filterType ?? "").includes(input.dataset.filterValue ?? ""); input.addEventListener("change", update); });
    if (select) { select.value = params.get("sort") ?? "name"; select.addEventListener("change", update); } update();
  </script>
</BaseLayout>
